<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <FanControlDir Condition="'$(FanControlDir)' == ''">C:\Program Files (x86)\FanControl</FanControlDir>
    <FanControlPlugins>$(FanControlDir)\FanControl.Plugins.dll</FanControlPlugins>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FanControl.LianLiWireless\FanControl.LianLiWireless.csproj" />
  </ItemGroup>

  <!-- The tests run against FanControl's own contract assembly when it is
       present and the stub otherwise; the test output is never shipped. -->
  <ItemGroup Condition="Exists('$(FanControlPlugins)')">
    <Reference Include="FanControl.Plugins">
      <HintPath>$(FanControlPlugins)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(FanControlPlugins)')">
    <ProjectReference Include="..\FanControl.Plugins.Stub\FanControl.Plugins.Stub.csproj" />
  </ItemGroup>

</Project>
