<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>FanControl.LianLiWireless</AssemblyName>
    <RootNamespace>FanControl.LianLiWireless</RootNamespace>
    <Version>0.2.1</Version>
    <FanControlDir Condition="'$(FanControlDir)' == ''">C:\Program Files (x86)\FanControl</FanControlDir>
    <FanControlPlugins>$(FanControlDir)\FanControl.Plugins.dll</FanControlPlugins>
  </PropertyGroup>

  <!-- FanControl's own contract assembly whenever it is present; the stub
       under ../FanControl.Plugins.Stub only where it is not. Neither is
       copied to the output. -->
  <ItemGroup Condition="Exists('$(FanControlPlugins)')">
    <Reference Include="FanControl.Plugins">
      <HintPath>$(FanControlPlugins)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(FanControlPlugins)')">
    <ProjectReference Include="..\FanControl.Plugins.Stub\FanControl.Plugins.Stub.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FanControl.LianLiWireless.Tests" />
  </ItemGroup>

</Project>
